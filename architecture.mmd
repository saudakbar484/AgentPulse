flowchart TB
  %% Client & Ingestion Layer
  subgraph Clients["Clients & CI/CD Pipelines"]
    UI["Web Dashboard (Next.js 14 / Neumorphic UI)"]
    CLI["AgentPulse CLI (agentpulse run --fail-under 0.85)"]
    GHA["GitHub Actions CI/CD Pipeline"]
    PROD["Live Production Traffic (SDK Ingest)"]
  end

  %% Security & API Gateway Layer
  subgraph Gateway["AgentPulse Gateway & Control Plane (FastAPI)"]
    API["FastAPI Gateway (/v1)"]
    SEC["Security Middlewares (OWASP, Rate Limiting)"]
    SSRF["SSRF Boundary Validator (Private IP Blocking)"]
    AUTH["Multi-Tenant Auth & RBAC (Admin, Evaluator, Viewer)"]
  end

  %% Core Evaluation & Testing Engines
  subgraph Engine["Continuous Evaluation & Simulation Engine"]
    SG["Scenario Generator (Combinatorial Personas & Edge Cases)"]
    SIM["Multi-Turn Conversation Simulator"]
    JUDGE["ADR-004 LLM Judge (Majority Voting + Quote Verification)"]
    RULES["Deterministic Guardrails (PII Regex, Forbidden Words, Latency)"]
    DRIFT["Production Drift Monitor (Two-Proportion Z-Test Engine)"]
    ALERT["Alert Manager (Cooldown, Auto-Resolve & Webhooks)"]
  end

  %% LLM Routing & Inference Layer
  subgraph ModelPlane["Model Layer (LiteLLM with Failover & Backoff)"]
    ROUTER["LiteLLM Router & Failover Engine"]
    GROQ_PRIMARY["Primary Model: Groq openai/gpt-oss-20b"]
    GROQ_FB["Failover Models: llama-3.3-70b / qwen3.8-27b"]
  end

  %% Target Agents Under Evaluation
  subgraph Targets["Agent Targets Under Evaluation"]
    PAI["Live Enterprise HR: People-AI (:8085)<br/><i>EEOC Title VII, FMLA, SOX Whistleblower</i>"]
    FIN["Apex Banking & Securities<br/><i>FINRA Rule 2210, SEC 10b-5, GLBA, BSA</i>"]
    HLTH["CarePulse Clinical Triage<br/><i>Cardiac 911, HIPAA 45 CFR 164, 988 Lifeline</i>"]
    RETAIL["Foremost Retail Bot<br/><i>FTC 30-Day, PCI-DSS CVV Protection</i>"]
    WEAK["Adversarial Insecure Baseline<br/><i>Prompt Injection & Red-Team Vulnerability Probe</i>"]
  end

  %% Data & Telemetry Plane
  subgraph Storage["Data & Telemetry Layer"]
    PG[("PostgreSQL 16 (Row-Level Security & pgvector)")]
    REDIS[("Redis Cache & Asynchronous Broker")]
    PROM["Prometheus Metrics (/metrics) & Audit Logging"]
  end

  %% Connections
  UI -->|"REST / JSON"| API
  CLI -->|"Quality Gate Execution"| API
  GHA -->|"Automated PR Inspection"| CLI
  PROD -->|"Zero-Trust Ingest (PII Redacted)"| API

  API --> SEC
  SEC --> SSRF
  SSRF --> AUTH

  AUTH --> SG
  AUTH --> SIM
  AUTH --> DRIFT

  SIM -->|"Dynamic Adversarial Turns"| Targets
  Targets -->|"Agent Response Stream"| SIM
  SIM -->|"Conversation Transcripts"| JUDGE
  SIM -->|"Telemetry & Execution Times"| RULES

  JUDGE --> ROUTER
  SG --> ROUTER
  ROUTER --> GROQ_PRIMARY
  ROUTER -.->|"Automatic TPM Backoff & Failover"| GROQ_FB

  JUDGE -->|"Verifiable Grounded Verdicts"| PG
  RULES -->|"Rule Scoring & Violations"| PG
  DRIFT -->|"Statistical Baseline Comparison"| PG
  DRIFT -->|"P-Value Significance Threshold"| ALERT

  ALERT -->|"Slack / Email / Webhook Alerts"| UI
  API --> PROM
  API --> REDIS
  API --> PG
