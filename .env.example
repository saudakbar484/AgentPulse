# ==============================================================================
# AgentPulse — Environment Configuration (.env.example)
# ==============================================================================

# Core Application
APP_NAME=AgentPulse
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/v1
SECRET_KEY=agentpulse-super-secret-dev-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://agentpulse:agentpulse_dev_password@localhost:5432/agentpulse
TEST_DATABASE_URL=postgresql+asyncpg://agentpulse:agentpulse_dev_password@localhost:5432/agentpulse_test

# Redis 7 (Arq Worker Queue & Cache)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO S3 / AWS S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=agentpulse-artifacts
S3_REGION=us-east-1

# Inference Gateway & LiteLLM
LITELLM_API_BASE=http://localhost:4000
SIMULATOR_MODEL=ollama/qwen2.5:7b
GENERATOR_MODEL=ollama/qwen2.5:7b
JUDGE_MODEL=ollama/qwen2.5:7b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Target Adapters & Security
SSRF_ALLOW_PRIVATE_IPS=false
CREDENTIAL_ENCRYPTION_KEY=gAAAAABl8n_sample_fernet_key_32_bytes_base64_encoded==

# Demo Bot
DEMO_BOT_URL=http://localhost:8080
